// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Prisma v7: Konfigurasi datasource (URL koneksi) dipindah ke prisma.config.ts
// Lihat: https://pris.ly/d/config-datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Role {
  PENGGUNA
  PETUGAS
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum FacilityStatus {
  AKTIF
  PERBAIKAN
  NONAKTIF
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReportStatus {
  BARU
  DIPROSES
  SELESAI
  DITOLAK
}

// ─────────────────────────────────────────
// Models
// ─────────────────────────────────────────

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  password      String
  role          Role
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())

  reservationsMade    Reservation[] @relation("MadeBy")
  reservationsDecided Reservation[] @relation("DecidedBy")
  reportsSubmitted    Report[]      @relation("ReportedBy")
  reportsHandled      Report[]      @relation("HandledBy")
  maintenancesCreated Maintenance[]
}

model Facility {
  id          Int            @id @default(autoincrement())
  name        String
  type        String
  location    String
  capacity    Int
  description String?
  status      FacilityStatus @default(AKTIF)
  imageUrl    String?

  reservations Reservation[]
  reports      Report[]
  maintenances Maintenance[]
}

model Reservation {
  id                 Int               @id @default(autoincrement())
  userId             Int
  user               User              @relation("MadeBy", fields: [userId], references: [id])
  facilityId         Int
  facility           Facility          @relation(fields: [facilityId], references: [id])
  startTime          DateTime
  endTime            DateTime
  purpose            String
  status             ReservationStatus @default(PENDING)
  cancellationReason String?
  rejectionReason    String?
  decidedById        Int?
  decidedBy          User?             @relation("DecidedBy", fields: [decidedById], references: [id])
  createdAt          DateTime          @default(now())

  @@index([facilityId, startTime, endTime])
}

model Report {
  id             Int          @id @default(autoincrement())
  reporterId     Int
  reporter       User         @relation("ReportedBy", fields: [reporterId], references: [id])
  facilityId     Int
  facility       Facility     @relation(fields: [facilityId], references: [id])
  category       String
  description    String
  photo          String?
  status         ReportStatus @default(BARU)
  resolutionNote String?
  handledById    Int?
  handledBy      User?        @relation("HandledBy", fields: [handledById], references: [id])
  createdAt      DateTime     @default(now())

  maintenances Maintenance[]
}

model Maintenance {
  id          Int       @id @default(autoincrement())
  facilityId  Int
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  reason      String
  reportId    Int?
  report      Report?   @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdById Int
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([facilityId, startDate, endDate])
}
